<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pizzería Borcelle - Menú Digital Interactivo</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts: Poppins -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: {
                            yellow: '#F3C532',
                            yellowDark: '#E6B325',
                            red: '#D32F2F',
                            redDark: '#B71C1C',
                            dark: '#1E1E1E',
                            bg: '#F9F6F0',
                            cardBg: '#FFFFFF'
                        }
                    },
                    fontFamily: {
                        sans: ['Poppins', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <style>
        /* Ocultar scrollbar pero permitir scroll funcional */
        .no-scrollbar::-webkit-scrollbar {
            display: none;
        }
        .no-scrollbar {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }
    </style>
</head>
<body class="bg-brand-bg text-brand-dark font-sans pb-32">

    <!-- Header / Branding -->
    <header class="bg-brand-yellow pt-6 pb-4 px-4 shadow-md sticky top-0 z-40">
        <div class="max-w-md mx-auto text-center">
            <div class="flex items-center justify-center gap-2 mb-1">
                <i class="fa-solid fa-pizza-slice text-brand-red text-3xl"></i>
                <h1 class="text-2xl font-extrabold uppercase tracking-wide text-brand-red drop-shadow-sm">
                    Pizzería Borcelle
                </h1>
            </div>
            <p class="text-xs font-semibold text-brand-dark opacity-80 uppercase tracking-widest mb-3">
                La mejor pizza de la ciudad desde 2010
            </p>

            <!-- Buscador -->
            <div class="relative">
                <i class="fa-solid fa-magnifying-glass absolute left-3 top-1/2 transform -translate-y-1/2 text-gray-400"></i>
                <input 
                    type="text" 
                    id="search-input" 
                    placeholder="Buscar plato, bebida, postre..." 
                    class="w-full pl-9 pr-4 py-2 rounded-full bg-white text-sm text-brand-dark focus:outline-none focus:ring-2 focus:ring-brand-red shadow-inner"
                    oninput="filterMenu()"
                >
            </div>
        </div>
    </header>

    <!-- Barra Deslizadora de Categorías (Horizontal Scroll) -->
    <nav class="sticky top-[118px] bg-brand-bg/95 backdrop-blur-sm z-30 py-3 border-b border-black/5 shadow-sm">
        <div class="max-w-md mx-auto px-4">
            <div class="flex space-x-2 overflow-x-auto no-scrollbar py-1">
                <button onclick="scrollToCategory('pizzas')" class="px-4 py-2 rounded-full bg-brand-red text-white text-xs font-bold whitespace-nowrap shadow-sm hover:bg-brand-redDark transition">
                    🍕 Pizzas
                </button>
                <button onclick="scrollToCategory('pastas')" class="px-4 py-2 rounded-full bg-white text-brand-dark border border-gray-200 text-xs font-bold whitespace-nowrap shadow-sm hover:bg-gray-50 transition">
                    🍝 Pastas
                </button>
                <button onclick="scrollToCategory('bebidas')" class="px-4 py-2 rounded-full bg-white text-brand-dark border border-gray-200 text-xs font-bold whitespace-nowrap shadow-sm hover:bg-gray-50 transition">
                    🥤 Bebidas
                </button>
                <button onclick="scrollToCategory('postres')" class="px-4 py-2 rounded-full bg-white text-brand-dark border border-gray-200 text-xs font-bold whitespace-nowrap shadow-sm hover:bg-gray-50 transition">
                    🍰 Postres
                </button>
            </div>
        </div>
    </nav>

    <!-- Contenido Principal / Menú -->
    <main class="max-w-md mx-auto px-4 mt-4 space-y-8" id="menu-container">

        <!-- Categoría: Pizzas -->
        <section id="pizzas" class="category-section">
            <div class="flex items-center gap-2 mb-3 border-b-2 border-brand-yellow pb-1">
                <span class="text-xl">🍕</span>
                <h2 class="text-lg font-bold uppercase tracking-wider text-brand-dark">Pizzas</h2>
            </div>
            <div class="grid grid-cols-2 gap-3 items-stretch">
                <!-- Card -->
                <div class="item-card bg-brand-cardBg rounded-xl p-3 shadow-sm border border-gray-100 flex flex-col justify-between h-full" data-name="margarita">
                    <div>
                        <h3 class="font-bold text-sm text-brand-dark">Margarita</h3>
                        <p class="text-xs text-gray-500 mt-0.5">Salsa de tomate, mozzarella fresca y albahaca.</p>
                    </div>
                    <div class="mt-3 pt-2 border-t border-gray-50 flex items-center justify-between">
                        <span class="font-extrabold text-sm text-brand-red">$95</span>
                        <div class="flex items-center bg-gray-100 rounded-lg p-0.5">
                            <button onclick="updateQty('margarita', -1)" class="w-6 h-6 flex items-center justify-center bg-white rounded shadow-sm text-xs font-bold text-gray-700 active:scale-95">-</button>
                            <span id="qty-margarita" class="w-6 text-center text-xs font-bold">0</span>
                            <button onclick="updateQty('margarita', 1)" class="w-6 h-6 flex items-center justify-center bg-brand-yellow rounded shadow-sm text-xs font-bold text-brand-dark active:scale-95">+</button>
                        </div>
                    </div>
                </div>

                <div class="item-card bg-brand-cardBg rounded-xl p-3 shadow-sm border border-gray-100 flex flex-col justify-between h-full" data-name="cuatro quesos">
                    <div>
                        <h3 class="font-bold text-sm text-brand-dark">Cuatro quesos</h3>
                        <p class="text-xs text-gray-500 mt-0.5">Mozzarella, gorgonzola, parmesano y fontina.</p>
                    </div>
                    <div class="mt-3 pt-2 border-t border-gray-50 flex items-center justify-between">
                        <span class="font-extrabold text-sm text-brand-red">$130</span>
                        <div class="flex items-center bg-gray-100 rounded-lg p-0.5">
                            <button onclick="updateQty('cuatro quesos', -1)" class="w-6 h-6 flex items-center justify-center bg-white rounded shadow-sm text-xs font-bold text-gray-700 active:scale-95">-</button>
                            <span id="qty-cuatro quesos" class="w-6 text-center text-xs font-bold">0</span>
                            <button onclick="updateQty('cuatro quesos', 1)" class="w-6 h-6 flex items-center justify-center bg-brand-yellow rounded shadow-sm text-xs font-bold text-brand-dark active:scale-95">+</button>
                        </div>
                    </div>
                </div>

                <div class="item-card bg-brand-cardBg rounded-xl p-3 shadow-sm border border-gray-100 flex flex-col justify-between h-full" data-name="vegetariana">
                    <div>
                        <h3 class="font-bold text-sm text-brand-dark">Vegetariana</h3>
                        <p class="text-xs text-gray-500 mt-0.5">Pimientos, champiñones, cebolla, aceitunas y pimentón.</p>
                    </div>
                    <div class="mt-3 pt-2 border-t border-gray-50 flex items-center justify-between">
                        <span class="font-extrabold text-sm text-brand-red">$100</span>
                        <div class="flex items-center bg-gray-100 rounded-lg p-0.5">
                            <button onclick="updateQty('vegetariana', -1)" class="w-6 h-6 flex items-center justify-center bg-white rounded shadow-sm text-xs font-bold text-gray-700 active:scale-95">-</button>
                            <span id="qty-vegetariana" class="w-6 text-center text-xs font-bold">0</span>
                            <button onclick="updateQty('vegetariana', 1)" class="w-6 h-6 flex items-center justify-center bg-brand-yellow rounded shadow-sm text-xs font-bold text-brand-dark active:scale-95">+</button>
                        </div>
                    </div>
                </div>

                <div class="item-card bg-brand-cardBg rounded-xl p-3 shadow-sm border border-gray-100 flex flex-col justify-between h-full" data-name="pepperoni">
                    <div>
                        <h3 class="font-bold text-sm text-brand-dark">Pepperoni</h3>
                        <p class="text-xs text-gray-500 mt-0.5">Salsa tradicional, doble queso y pepperoni crujiente.</p>
                    </div>
                    <div class="mt-3 pt-2 border-t border-gray-50 flex items-center justify-between">
                        <span class="font-extrabold text-sm text-brand-red">$115</span>
                        <div class="flex items-center bg-gray-100 rounded-lg p-0.5">
                            <button onclick="updateQty('pepperoni', -1)" class="w-6 h-6 flex items-center justify-center bg-white rounded shadow-sm text-xs font-bold text-gray-700 active:scale-95">-</button>
                            <span id="qty-pepperoni" class="w-6 text-center text-xs font-bold">0</span>
                            <button onclick="updateQty('pepperoni', 1)" class="w-6 h-6 flex items-center justify-center bg-brand-yellow rounded shadow-sm text-xs font-bold text-brand-dark active:scale-95">+</button>
                        </div>
                    </div>
                </div>

                <div class="item-card bg-brand-cardBg rounded-xl p-3 shadow-sm border border-gray-100 flex flex-col justify-between h-full" data-name="napolitana">
                    <div>
                        <h3 class="font-bold text-sm text-brand-dark">Napolitana</h3>
                        <p class="text-xs text-gray-500 mt-0.5">Rodajas de tomate fresco, ajo, orégano y mozzarella.</p>
                    </div>
                    <div class="mt-3 pt-2 border-t border-gray-50 flex items-center justify-between">
                        <span class="font-extrabold text-sm text-brand-red">$120</span>
                        <div class="flex items-center bg-gray-100 rounded-lg p-0.5">
                            <button onclick="updateQty('napolitana', -1)" class="w-6 h-6 flex items-center justify-center bg-white rounded shadow-sm text-xs font-bold text-gray-700 active:scale-95">-</button>
                            <span id="qty-napolitana" class="w-6 text-center text-xs font-bold">0</span>
                            <button onclick="updateQty('napolitana', 1)" class="w-6 h-6 flex items-center justify-center bg-brand-yellow rounded shadow-sm text-xs font-bold text-brand-dark active:scale-95">+</button>
                        </div>
                    </div>
                </div>

                <div class="item-card bg-brand-cardBg rounded-xl p-3 shadow-sm border border-gray-100 flex flex-col justify-between h-full" data-name="carnivora">
                    <div>
                        <h3 class="font-bold text-sm text-brand-dark">Carnívora</h3>
                        <p class="text-xs text-gray-500 mt-0.5">Jamón, pepperoni, carne molida y tocineta ahumada.</p>
                    </div>
                    <div class="mt-3 pt-2 border-t border-gray-50 flex items-center justify-between">
                        <span class="font-extrabold text-sm text-brand-red">$150</span>
                        <div class="flex items-center bg-gray-100 rounded-lg p-0.5">
                            <button onclick="updateQty('carnivora', -1)" class="w-6 h-6 flex items-center justify-center bg-white rounded shadow-sm text-xs font-bold text-gray-700 active:scale-95">-</button>
                            <span id="qty-carnivora" class="w-6 text-center text-xs font-bold">0</span>
                            <button onclick="updateQty('carnivora', 1)" class="w-6 h-6 flex items-center justify-center bg-brand-yellow rounded shadow-sm text-xs font-bold text-brand-dark active:scale-95">+</button>
                        </div>
                    </div>
                </div>

                <div class="item-card bg-brand-cardBg rounded-xl p-3 shadow-sm border border-gray-100 flex flex-col justify-between h-full" data-name="picante">
                    <div>
                        <h3 class="font-bold text-sm text-brand-dark">Picante</h3>
                        <p class="text-xs text-gray-500 mt-0.5">Salami picante, jalapeños y aceite de peperoncino.</p>
                    </div>
                    <div class="mt-3 pt-2 border-t border-gray-50 flex items-center justify-between">
                        <span class="font-extrabold text-sm text-brand-red">$140</span>
                        <div class="flex items-center bg-gray-100 rounded-lg p-0.5">
                            <button onclick="updateQty('picante', -1)" class="w-6 h-6 flex items-center justify-center bg-white rounded shadow-sm text-xs font-bold text-gray-700 active:scale-95">-</button>
                            <span id="qty-picante" class="w-6 text-center text-xs font-bold">0</span>
                            <button onclick="updateQty('picante', 1)" class="w-6 h-6 flex items-center justify-center bg-brand-yellow rounded shadow-sm text-xs font-bold text-brand-dark active:scale-95">+</button>
                        </div>
                    </div>
                </div>

                <div class="item-card bg-brand-cardBg rounded-xl p-3 shadow-sm border border-gray-100 flex flex-col justify-between h-full" data-name="hawaiana">
                    <div>
                        <h3 class="font-bold text-sm text-brand-dark">Hawaiana</h3>
                        <p class="text-xs text-gray-500 mt-0.5">Jamón dulce, piña troceada y queso mozzarella.</p>
                    </div>
                    <div class="mt-3 pt-2 border-t border-gray-50 flex items-center justify-between">
                        <span class="font-extrabold text-sm text-brand-red">$130</span>
                        <div class="flex items-center bg-gray-100 rounded-lg p-0.5">
                            <button onclick="updateQty('hawaiana', -1)" class="w-6 h-6 flex items-center justify-center bg-white rounded shadow-sm text-xs font-bold text-gray-700 active:scale-95">-</button>
                            <span id="qty-hawaiana" class="w-6 text-center text-xs font-bold">0</span>
                            <button onclick="updateQty('hawaiana', 1)" class="w-6 h-6 flex items-center justify-center bg-brand-yellow rounded shadow-sm text-xs font-bold text-brand-dark active:scale-95">+</button>
                        </div>
