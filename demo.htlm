    </main>

    <!-- Barra Flotante de Carrito / WhatsApp -->
    <div class="fixed bottom-0 left-0 right-0 p-4 bg-gradient-to-t from-white via-white/95 to-transparent z-50">
        <div class="max-w-md mx-auto bg-brand-dark text-white rounded-2xl p-4 shadow-2xl border border-gray-800 flex items-center justify-between gap-3">
            <div>
                <div class="text-xs text-gray-400 font-medium">
                    <span id="total-count" class="font-bold text-brand-yellow">0</span> items seleccionados
                </div>
                <div class="text-lg font-extrabold text-white">
                    Total: <span id="total-price" class="text-brand-yellow">$0</span>
                </div>
            </div>

            <button 
                onclick="sendWhatsAppOrder()" 
                class="bg-emerald-600 hover:bg-emerald-700 text-white px-4 py-2.5 rounded-xl font-bold text-xs flex items-center gap-2 shadow-lg transition active:scale-95">
                <i class="fa-brands fa-whatsapp text-lg"></i>
                <span>Enviar Pedido</span>
            </button>
        </div>
    </div>

    <!-- JavaScript para lógica interactiva -->
    <script>
        // Datos de productos
        const products = {
            'margarita': { name: 'Pizza Margarita', price: 95 },
            'cuatro quesos': { name: 'Pizza Cuatro quesos', price: 130 },
            'vegetariana': { name: 'Pizza Vegetariana', price: 100 },
            'pepperoni': { name: 'Pizza Pepperoni', price: 115 },
            'napolitana': { name: 'Pizza Napolitana', price: 120 },
            'carnivora': { name: 'Pizza Carnívora', price: 150 },
            'picante': { name: 'Pizza Picante', price: 140 },
            'hawaiana': { name: 'Pizza Hawaiana', price: 130 },

            'al pesto': { name: 'Pasta Al pesto', price: 80 },
            'a la boloñesa': { name: 'Pasta A la boloñesa', price: 90 },
            'cuatro quesos pasta': { name: 'Pasta Cuatro quesos', price: 100 },
            'alfredo': { name: 'Pasta Alfredo', price: 115 },
            'con tomate fresco': { name: 'Pasta Con tomate fresco', price: 120 },
            'con mariscos': { name: 'Pasta Con mariscos', price: 150 },
            'con vegetales': { name: 'Pasta Con vegetales', price: 100 },
            'con salsa picante': { name: 'Pasta Con salsa picante', price: 120 },

            'refresco': { name: 'Refresco', price: 30 },
            'limonada': { name: 'Limonada', price: 30 },
            'agua': { name: 'Agua', price: 20 },
            'cafe': { name: 'Café', price: 25 },

            'tiramisu': { name: 'Tiramisú', price: 55 },
            'helado de limon': { name: 'Helado de limón', price: 40 },
            'helado de chocolate': { name: 'Helado de chocolate', price: 45 },
            'tarta de pistache': { name: 'Tarta de pistache', price: 75 }
        };

        const cart = {};

        // Actualizar cantidades
        function updateQty(id, change) {
            const currentQty = cart[id] || 0;
            const newQty = Math.max(0, currentQty + change);
            
            if (newQty === 0) {
                delete cart[id];
            } else {
                cart[id] = newQty;
            }

            // Actualizar UI del item
            const qtyElement = document.getElementById(`qty-${id}`);
            if (qtyElement) {
                qtyElement.innerText = newQty;
            }

            updateTotals();
        }

        // Actualizar acumulador total
        function updateTotals() {
            let totalItems = 0;
            let totalPrice = 0;

            for (const [id, qty] of Object.entries(cart)) {
                totalItems += qty;
                totalPrice += qty * products[id].price;
            }

            document.getElementById('total-count').innerText = totalItems;
            document.getElementById('total-price').innerText = `$${totalPrice}`;
        }

        // Navegación suave por categorías
        function scrollToCategory(id) {
            const section = document.getElementById(id);
            if (section) {
                const yOffset = -170; // Offset para compensar headers fijos
                const y = section.getBoundingClientRect().top + window.pageYOffset + yOffset;
                window.scrollTo({ top: y, behavior: 'smooth' });
            }
        }

        // Filtro de búsqueda en tiempo real
        function filterMenu() {
            const query = document.getElementById('search-input').value.toLowerCase().trim();
            const cards = document.querySelectorAll('.item-card');
            const sections = document.querySelectorAll('.category-section');

            cards.forEach(card => {
                const name = card.getAttribute('data-name');
                if (name.includes(query)) {
                    card.style.display = 'flex';
                } else {
                    card.style.display = 'none';
                }
            });

            // Ocultar categorías si no tienen elementos visibles
            sections.forEach(section => {
                const visibleCards = section.querySelectorAll('.item-card[style="display: flex;"], .item-card:not([style*="display: none"])');
                if (visibleCards.length === 0 && query !== '') {
                    section.style.display = 'none';
                } else {
                    section.style.display = 'block';
                }
            });
        }

        // Enviar pedido por WhatsApp
        function sendWhatsAppOrder() {
            const phoneNumber = "584120000000"; // Reemplazar por el número real del restaurante
            const items = Object.entries(cart);

            if (items.length === 0) {
                alert("Por favor, selecciona al menos un producto para realizar tu pedido.");
                return;
            }

            let message = "🍕 *NUEVO PEDIDO - PIZZERÍA BORCELLE* 🍕\n\n";
            message += "Hola, me gustaría realizar el siguiente pedido:\n\n";

            let total = 0;
            items.forEach(([id, qty]) => {
                const itemTotal = qty * products[id].price;
                total += itemTotal;
                message += `• ${qty}x ${products[id].name} - $${itemTotal}\n`;
            });

            message += `\n💰 *TOTAL A PAGAR: $${total}*\n\n`;
            message += "📍 *Dirección de entrega:* (Escribe tu dirección aquí)\n";
            message += "💳 *Método de pago:* (Efectivo / Transferencia)\n\n";
            message += "¡Muchas gracias!";

            const encodedMessage = encodeURIComponent(message);
            window.open(`https://wa.me/${phoneNumber}?text=${encodedMessage}`, '_blank');
        }
    </script>
</body>
</html>
