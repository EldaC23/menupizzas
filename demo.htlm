        </section>

        <!-- Categoría: Bebidas -->
        <section id="bebidas" class="category-section">
            <div class="flex items-center gap-2 mb-3 border-b-2 border-brand-yellow pb-1">
                <span class="text-xl">🥤</span>
                <h2 class="text-lg font-bold uppercase tracking-wider text-brand-dark">Bebidas</h2>
