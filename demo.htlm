                            <button onclick="updateQty('tarta de pistache', -1)" class="w-6 h-6 flex items-center justify-center bg-white rounded shadow-sm text-xs font-bold text-gray-700 active:scale-95">-</button>
                            <span id="qty-tarta de pistache" class="w-6 text-center text-xs font-bold">0</span>
                            <button onclick="updateQty('tarta de pistache', 1)" class="w-6 h-6 flex items-center justify-center bg-brand-yellow rounded shadow-sm text-xs font-bold text-brand-dark active:scale-95">+</button>
