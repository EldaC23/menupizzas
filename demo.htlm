                    </div>
                    <div class="mt-3 pt-2 border-t border-gray-50 flex items-center justify-between">
                        <span class="font-extrabold text-sm text-brand-red">$55</span>
                        <div class="flex items-center bg-gray-100 rounded-lg p-0.5">
                            <button onclick="updateQty('tiramisu', -1)" class="w-6 h-6 flex items-center justify-center bg-white rounded shadow-sm text-xs font-bold text-gray-700 active:scale-95">-</button>
                            <span id="qty-tiramisu" class="w-6 text-center text-xs font-bold">0</span>
