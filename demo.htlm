                    <div class="mt-3 pt-2 border-t border-gray-50 flex items-center justify-between">
                        <span class="font-extrabold text-sm text-brand-red">$90</span>
                        <div class="flex items-center bg-gray-100 rounded-lg p-0.5">
                            <button onclick="updateQty('a la boloñesa', -1)" class="w-6 h-6 flex items-center justify-center bg-white rounded shadow-sm text-xs font-bold text-gray-700 active:scale-95">-</button>
                            <span id="qty-a la boloñesa" class="w-6 text-center text-xs font-bold">0</span>
                            <button onclick="updateQty('a la boloñesa', 1)" class="w-6 h-6 flex items-center justify-center bg-brand-yellow rounded shadow-sm text-xs font-bold text-brand-dark active:scale-95">+</button>
                        </div>
                    </div>
                </div>

                <div class="item-card bg-brand-cardBg rounded-xl p-3 shadow-sm border border-gray-100 flex flex-col justify-between h-full" data-name="cuatro quesos pasta">
                    <div>
                        <h3 class="font-bold text-sm text-brand-dark">Cuatro quesos</h3>
                        <p class="text-xs text-gray-500 mt-0.5">Cremosa combinación de quesos madurados.</p>
                    </div>
                    <div class="mt-3 pt-2 border-t border-gray-50 flex items-center justify-between">
                        <span class="font-extrabold text-sm text-brand-red">$100</span>
                        <div class="flex items-center bg-gray-100 rounded-lg p-0.5">
                            <button onclick="updateQty('cuatro quesos pasta', -1)" class="w-6 h-6 flex items-center justify-center bg-white rounded shadow-sm text-xs font-bold text-gray-700 active:scale-95">-</button>
                            <span id="qty-cuatro quesos pasta" class="w-6 text-center text-xs font-bold">0</span>
                            <button onclick="updateQty('cuatro quesos pasta', 1)" class="w-6 h-6 flex items-center justify-center bg-brand-yellow rounded shadow-sm text-xs font-bold text-brand-dark active:scale-95">+</button>
                        </div>
                    </div>
                </div>

                <div class="item-card bg-brand-cardBg rounded-xl p-3 shadow-sm border border-gray-100 flex flex-col justify-between h-full" data-name="alfredo">
                    <div>
                        <h3 class="font-bold text-sm text-brand-dark">Alfredo</h3>
                        <p class="text-xs text-gray-500 mt-0.5">Salsa blanca a base de crema, mantequilla y parmesano.</p>
                    </div>
                    <div class="mt-3 pt-2 border-t border-gray-50 flex items-center justify-between">
                        <span class="font-extrabold text-sm text-brand-red">$115</span>
                        <div class="flex items-center bg-gray-100 rounded-lg p-0.5">
