        <!-- Categoría: Postres -->
        <section id="postres" class="category-section">
            <div class="flex items-center gap-2 mb-3 border-b-2 border-brand-yellow pb-1">
                <span class="text-xl">🍰</span>
                <h2 class="text-lg font-bold uppercase tracking-wider text-brand-dark">Postres</h2>
            </div>
            <div class="grid grid-cols-2 gap-3 items-stretch">

                <div class="item-card bg-brand-cardBg rounded-xl p-3 shadow-sm border border-gray-100 flex flex-col justify-between h-full" data-name="tiramisu">
