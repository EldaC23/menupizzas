        </section>

        <!-- Categoría: Pastas -->
        <section id="pastas" class="category-section">
            <div class="flex items-center gap-2 mb-3 border-b-2 border-brand-yellow pb-1">
                <span class="text-xl">🍝</span>
                <h2 class="text-lg font-bold uppercase tracking-wider text-brand-dark">Pastas</h2>
            </div>
            <div class="grid grid-cols-2 gap-3 items-stretch">

                <div class="item-card bg-brand-cardBg rounded-xl p-3 shadow-sm border border-gray-100 flex flex-col justify-between h-full" data-name="al pesto">
                    <div>
                        <h3 class="font-bold text-sm text-brand-dark">Al pesto</h3>
                        <p class="text-xs text-gray-500 mt-0.5">Salsa de albahaca fresca, piñones y parmesano.</p>
                    </div>
                    <div class="mt-3 pt-2 border-t border-gray-50 flex items-center justify-between">
                        <span class="font-extrabold text-sm text-brand-red">$80</span>
                        <div class="flex items-center bg-gray-100 rounded-lg p-0.5">
                            <button onclick="updateQty('al pesto', -1)" class="w-6 h-6 flex items-center justify-center bg-white rounded shadow-sm text-xs font-bold text-gray-700 active:scale-95">-</button>
                            <span id="qty-al pesto" class="w-6 text-center text-xs font-bold">0</span>
                            <button onclick="updateQty('al pesto', 1)" class="w-6 h-6 flex items-center justify-center bg-brand-yellow rounded shadow-sm text-xs font-bold text-brand-dark active:scale-95">+</button>
                        </div>
                    </div>
                </div>

                <div class="item-card bg-brand-cardBg rounded-xl p-3 shadow-sm border border-gray-100 flex flex-col justify-between h-full" data-name="a la boloñesa">
                    <div>
                        <h3 class="font-bold text-sm text-brand-dark">A la boloñesa</h3>
                        <p class="text-xs text-gray-500 mt-0.5">Tradicional salsa de carne y tomate italiano.</p>
