                            <button onclick="updateQty('con tomate fresco', 1)" class="w-6 h-6 flex items-center justify-center bg-brand-yellow rounded shadow-sm text-xs font-bold text-brand-dark active:scale-95">+</button>
                        </div>
                    </div>
                </div>

                <div class="item-card bg-brand-cardBg rounded-xl p-3 shadow-sm border border-gray-100 flex flex-col justify-between h-full" data-name="con mariscos">
                    <div>
                        <h3 class="font-bold text-sm text-brand-dark">Con mariscos</h3>
                        <p class="text-xs text-gray-500 mt-0.5">Camarones y calamares en salsa marinara.</p>
